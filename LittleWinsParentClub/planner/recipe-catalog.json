eesy Bean Tacos", "ingredients": ["1 can (15 oz) refried beans", "8 small tortillas", "1 cup shredded cheddar", "¼ cup water", "Optional: mild salsa or mashed avocado"], "source": "https://littlewinsparentclub.com/picky-eaters.html#recipe-easy-bean-tacos", "image": "images/bean-cheese-quesadillas.jpg", "mealType": "Lunch"}, {"id": "easy-rice-bowls", "title": "Mix-And-Match Chicken & Rice Bowls", "ingredients": ["2 cups fully cooked shredded chicken", "2 pouches microwave rice (about 8.8 oz each)", "2 cups frozen vegetables", "¼ cup low-sodium broth", "Optional: a familiar mild sauce"], "source": "https://littlewinsparentclub.com/picky-eaters.html#recipe-easy-rice-bowls", "image": "images/carrot-pea-rice.jpg", "mealType": "Dinner"}]